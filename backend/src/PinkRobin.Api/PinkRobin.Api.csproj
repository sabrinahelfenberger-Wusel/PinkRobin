<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <SpaRoot>../../../web/</SpaRoot>
    <SpaProxyServerUrl>http://localhost:4200</SpaProxyServerUrl>
    <SpaProxyRedirectUrl>http://localhost:4200/#/virtual-robin</SpaProxyRedirectUrl>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
    <SpaProxyKeepRunning>false</SpaProxyKeepRunning>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.12" />
    <None Include="$(SpaRoot)src/**/*" Link="Frontend/src/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(SpaRoot)package.json;$(SpaRoot)proxy.conf.json;$(SpaRoot)angular.json" Link="Frontend/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="EnsureFrontendDependencies" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And Exists('$(SpaRoot)package-lock.json') And !Exists('$(SpaRoot)node_modules/@angular/cli/bin/ng.js')">
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="NodeCheckExitCode" />
    </Exec>
    <Error Condition="'$(NodeCheckExitCode)' != '0'"
           Text="Node.js 22.12+ und npm installieren, danach Visual Studio neu starten." />
    <Message Importance="high" Text="Angular-Abhängigkeiten werden einmalig installiert ..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
  </Target>
</Project>
